{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrkoWallet - Grin",
  "version": "0.1.2",
  "identifier": "io.orkoswap.orkowallet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "publisher": "Orko",
    "copyright": "© Orko",
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../vendor/tor-16.0.1/": "tor/"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
